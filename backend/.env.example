DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=verify-full
# Optional unpooled Neon URL for migrations. Neon pooler URLs are converted automatically.
DIRECT_URL=
JWT_SECRET=
# Preserve the same encryption key across deployments. If omitted, JWT_SECRET is used.
INTEGRATION_ENCRYPTION_KEY=
PORT=8000
# Local development only. On Vercel OMIT this to use VERCEL_PROJECT_PRODUCTION_URL automatically.
FRONTEND_URL=http://localhost:5173

# Use one Stripe account and mode consistently for keys, prices and webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_REQUIRE_TERMS_OF_SERVICE=false

# Match PAYPAL_ENV, client ID, secret, webhook and plan IDs to the same PayPal app.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_PLUS_MONTHLY=
PAYPAL_PLAN_PLUS_ANNUAL=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_ANNUAL=

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
