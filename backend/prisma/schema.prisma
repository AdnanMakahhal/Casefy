generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  manager
  qa_engineer
  student
  employee
  developer
}

enum Plan {
  free
  plus
  pro
  ultra @map("custom")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(student)
  isSupportAgent Boolean @default(false) @map("is_support_agent")
  isSynthetic Boolean @default(false) @map("is_synthetic")
  plan          Plan     @default(free)
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(6)
  blockedReason String? @map("blocked_reason") @db.VarChar(500)
  seatLimit     Int?     @map("seat_limit")
  projectLimit  Int?     @map("project_limit")
  monthlyCreditLimit Int? @map("monthly_credit_limit")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripeCheckoutSessionId String? @map("stripe_checkout_session_id")
  subscriptionStatus String? @map("subscription_status")
  subscriptionStartedAt DateTime? @map("subscription_started_at") @db.Timestamptz(6)
  subscriptionPeriodEnd DateTime? @map("subscription_period_end") @db.Timestamptz(6)
  complimentaryPlan Plan? @map("complimentary_plan")
  complimentaryStartsAt DateTime? @map("complimentary_starts_at") @db.Timestamptz(6)
  complimentaryEndsAt DateTime? @map("complimentary_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  workspaceName String?  @map("workspace_name") @db.VarChar(80)
  workspaceNames String[] @default([]) @map("workspace_names")
  avatarImage   String?  @map("avatar_image")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ownedWorkspaces Workspace[]
  workspaceMemberships WorkspaceMember[]
  projects      Project[]
  supportRequests SupportRequest[]
  receivedMessages UserMessage[] @relation("MessageRecipient")
  sentMessages UserMessage[] @relation("MessageSender")
  generationRuns GenerationRun[]
  refunds RefundRecord[] @relation("RefundCustomer")
  issuedRefunds RefundRecord[] @relation("RefundActor")
  creditEntries CreditEntry[]
  payments PaymentRecord[]
  customDeals CustomDeal[] @relation("DealCustomer")
  approvedDeals CustomDeal[] @relation("DealApprover")
  assignedRequests SupportRequest[] @relation("RequestAssignee")

  @@map("users")
}

model Project {
  id           Int      @id @default(autoincrement())
  ownerId      Int      @map("owner_id")
  workspaceKey String   @default("primary") @map("workspace_key") @db.VarChar(32)
  workspaceId String @map("workspace_id") @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(100)
  description  String?
  generationRequest Json? @map("generation_request")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, workspaceKey])
  @@index([workspaceId])
  @@map("projects")
}

model StripeWebhookEvent {
  id String @id
  type String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("stripe_webhook_events")
}

model SupportRequest {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  email       String   @db.VarChar(254)
  subject     String   @db.VarChar(160)
  description String   @db.VarChar(5000)
  category    String   @default("support") @db.VarChar(20)
  status      String   @default("open") @db.VarChar(20)
  details     Json?
  assignedToId Int? @map("assigned_to_id")
  assignedTo User? @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  deals CustomDeal[]
  userId      Int?     @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    UserMessage[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("support_requests")
  @@index([category, status, createdAt])
}

model UserMessage {
  id Int @id @default(autoincrement())
  recipientId Int? @map("recipient_id")
  senderId Int? @map("sender_id")
  supportRequestId Int? @map("support_request_id")
  recipient User? @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender User? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  supportRequest SupportRequest? @relation(fields: [supportRequestId], references: [id], onDelete: SetNull)
  toEmail String @map("to_email") @db.VarChar(254)
  subject String @db.VarChar(160)
  body String @db.VarChar(10000)
  channel String @default("in_app") @db.VarChar(20)
  deliveryStatus String @default("sent") @map("delivery_status") @db.VarChar(20)
  providerMessageId String? @map("provider_message_id")
  readAt DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([recipientId, createdAt])
  @@index([supportRequestId, createdAt])
  @@map("user_messages")
}

model IntegrationSetting {
  provider String @id @db.VarChar(30)
  secretCiphertext String? @map("secret_ciphertext")
  model String? @db.VarChar(100)
  senderEmail String? @map("sender_email") @db.VarChar(254)
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("integration_settings")
}

model GenerationRun {
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String @db.VarChar(160)
  source String @db.VarChar(20)
  provider String @db.VarChar(30)
  model String @db.VarChar(100)
  requestedCount Int @map("requested_count")
  testCount Int @default(0) @map("test_count")
  status String @default("running") @db.VarChar(20)
  result Json?
  error String? @db.VarChar(500)
  creditsUsed Int @default(0) @map("credits_used")
  creditEntries CreditEntry[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, createdAt])
  @@map("generation_runs")
}

model CreditEntry {
  id String @id @default(uuid()) @db.Uuid
  userId Int @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Int
  kind String @db.VarChar(30)
  description String @db.VarChar(250)
  operationKey String @unique @map("operation_key") @db.VarChar(160)
  generationRunId Int? @map("generation_run_id")
  generationRun GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd DateTime @map("period_end") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, periodStart, createdAt])
  @@map("credit_entries")
}

model PaymentRecord {
  id String @id @default(uuid()) @db.Uuid
  userId Int @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  externalId String? @unique @map("external_id")
  amount Int
  amountRefunded Int @default(0) @map("amount_refunded")
  currency String @default("usd") @db.VarChar(3)
  status String @db.VarChar(30)
  source String @default("stripe") @db.VarChar(20)
  plan Plan
  description String @db.VarChar(250)
  receiptUrl String? @map("receipt_url")
  liveMode Boolean @default(false) @map("live_mode")
  disputed Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("payment_records")
}

model CustomDeal {
  id String @id @default(uuid()) @db.Uuid
  userId Int @map("user_id")
  user User @relation("DealCustomer", fields: [userId], references: [id], onDelete: Cascade)
  supportRequestId Int @map("support_request_id")
  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  approvedById Int @map("approved_by_id")
  approvedBy User @relation("DealApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  status String @default("offered") @db.VarChar(30)
  amount Int
  currency String @default("usd") @db.VarChar(3)
  interval String @default("month") @db.VarChar(10)
  seats Int
  projects Int
  monthlyCredits Int @map("monthly_credits")
  notes String @db.VarChar(2000)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)
  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, status])
  @@map("custom_deals")
}

model RefundRecord {
  id String @id @db.VarChar(36)
  userId Int @map("user_id")
  actorId Int? @map("actor_id")
  user User @relation("RefundCustomer", fields: [userId], references: [id], onDelete: Restrict)
  actor User? @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)
  chargeId String @map("charge_id")
  amount Int
  currency String @db.VarChar(3)
  reason String @db.VarChar(500)
  status String @default("pending") @db.VarChar(20)
  stripeRefundId String? @unique @map("stripe_refund_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, createdAt])
  @@map("refund_records")
}

model Workspace {
  id String @id @default(uuid()) @db.Uuid
  ownerId Int @map("owner_id")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String @db.VarChar(80)
  normalizedName String @map("normalized_name") @db.VarChar(80)
  legacyKey String? @map("legacy_key") @db.VarChar(32)
  isPrimary Boolean @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  members WorkspaceMember[]
  invites WorkspaceInvite[]
  projects Project[]
  @@unique([ownerId, legacyKey])
  @@index([ownerId])
  @@map("workspaces")
}
model WorkspaceMember {
  workspaceId String @map("workspace_id") @db.Uuid
  userId Int @map("user_id")
  role String @default("viewer") @db.VarChar(10)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}
model WorkspaceInvite {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  role String @default("viewer") @db.VarChar(10)
  email String? @db.VarChar(254)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy Int? @map("accepted_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([workspaceId])
  @@map("workspace_invites")
}
